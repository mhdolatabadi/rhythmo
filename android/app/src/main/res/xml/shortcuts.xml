<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts (#227). Each opens the app with a rhythmo:// link
     that MainActivity hands to Dart like an App Link. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shuffle"
        android:enabled="true"
        android:icon="@drawable/shortcut_shuffle"
        android:shortcutShortLabel="@string/shortcut_shuffle_short"
        android:shortcutLongLabel="@string/shortcut_shuffle_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ir.mhdolatabadi.nafir"
            android:targetClass="ir.mhdolatabadi.nafir.MainActivity"
            android:data="rhythmo://shortcut/shuffle"/>
    </shortcut>
    <shortcut
        android:shortcutId="resume"
        android:enabled="true"
        android:icon="@drawable/shortcut_resume"
        android:shortcutShortLabel="@string/shortcut_resume_short"
        android:shortcutLongLabel="@string/shortcut_resume_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ir.mhdolatabadi.nafir"
            android:targetClass="ir.mhdolatabadi.nafir.MainActivity"
            android:data="rhythmo://shortcut/resume"/>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ir.mhdolatabadi.nafir"
            android:targetClass="ir.mhdolatabadi.nafir.MainActivity"
            android:data="rhythmo://shortcut/search"/>
    </shortcut>
</shortcuts>
